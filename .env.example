# Local multilingual embedding model (downloaded once by sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_N=12
FINAL_K=5
MIN_DENSE_SCORE=0.20
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Any OpenAI-compatible endpoint (Ollama example: http://localhost:11434/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b

# Lab 2: persistent LangGraph state, idempotent local report stub and JSONL audit
AGENT_CHECKPOINT_DB=storage/agent_checkpoints.sqlite
AGENT_REPORTS_DB=storage/agent_reports.sqlite
AGENT_LOG_PATH=logs/graph_run.jsonl
AGENT_TIMEZONE=Europe/Moscow
